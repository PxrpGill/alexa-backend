SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=alexa
DB_USER=alexa
DB_PASSWORD=alexa
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:3000
CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/1
MAX_RESUME_SIZE=5242880

# Обратный прокси (см. apps/common/throttling.py и apps/vacancies/views.py).
# По умолчанию оба включены при DEBUG=False; менять только если схема доставки
# трафика отличается от «nginx перед gunicorn».
TRUST_PROXY_HEADERS=False
USE_X_ACCEL_REDIRECT=False

# Уведомления о заявках в мессенджер MAX.
# Пустой токен или чат = интеграция выключена.
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_API_URL=https://platform-api.max.ru
# Базовый адрес сайта для ссылок на админку в уведомлениях.
SITE_URL=http://localhost:8000

# Домен публичного сайта (Next.js). Из него строится поле «Откуда сделана заявка»:
# сайт и бэкенд на разных доменах, поэтому без этой переменной ссылка вела бы на API.
FRONTEND_URL=http://localhost:3000
