# Django
SECRET_KEY=your-strong-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Database (Django)
DB_NAME=alexa
DB_USER=alexa
DB_PASSWORD=your-strong-db-password
DB_HOST=db
DB_PORT=5432

# Database (Postgres container)
POSTGRES_DB=alexa
POSTGRES_USER=alexa
POSTGRES_PASSWORD=your-strong-db-password

# Docker image (ghcr.io/your-github-username/alexa-backend:latest)
# ВАЖНО: имя образа в GHCR только в нижнем регистре (PxrpGill -> pxrpgill), иначе pull падает
DOCKER_IMAGE=ghcr.io/your-github-username/alexa-backend:latest

# Celery
CELERY_BROKER_URL=redis://redis:6379/0

# Обратный прокси (см. apps/common/throttling.py и apps/vacancies/views.py).
# По умолчанию оба включены при DEBUG=False; менять только если схема доставки
# трафика отличается от «nginx перед gunicorn».
TRUST_PROXY_HEADERS=True
USE_X_ACCEL_REDIRECT=True
