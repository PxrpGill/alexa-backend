# Шаблон: официальный образ nginx подставляет ${DOMAIN} через envsubst при старте
# (каталог монтируется в /etc/nginx/templates, результат попадает в conf.d).
# Домен живёт в docker/prod/.env.prod, в самом конфиге его нет — поэтому файл
# обновляется обычным `git pull` и не требует skip-worktree.
#
# Подставляется ТОЛЬКО ${DOMAIN} (NGINX_ENVSUBST_FILTER=DOMAIN в compose);
# переменные nginx вида $host, $binary_remote_addr остаются как есть.

# Встроенный DNS-резолвер Docker. Без него nginx резолвит имя `web` один раз при
# старте и держит IP до перезапуска: после деплоя контейнер web получает новый
# адрес, а nginx продолжает отдавать 502, пока его не перезапустят вручную.
resolver 127.0.0.11 valid=10s ipv6=off;

# Лимиты по IP: подбор пароля в админке и флуд заявками.
# Пустой ключ = запрос не учитывается, поэтому api_write считает только POST —
# публичные GET-эндпоинты (врачи, блог, акции) не должны попадать под лимит.
map $request_method $api_write_key {
    default "";
    POST    $binary_remote_addr;
}

limit_req_zone $binary_remote_addr zone=admin_login:10m rate=5r/m;
limit_req_zone $api_write_key      zone=api_write:10m  rate=30r/m;
limit_req_status 429;

# Запросы с чужим/пустым Host не должны доходить до приложения.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate         /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key     /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${DOMAIN}/chain.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 20M;

    # Фронтенд на Vercel (США) ходит в API отсюда, из РФ: ответы крупнее ~16 КБ
    # там зависали до таймаута, мелкие проходили. gzip ужимает JSON в 7–8 раз
    # (детальная акция 20 КБ → 2,7 КБ, статья блога 36 КБ → 4,4 КБ).
    # gzip_proxied any — ответы приходят из gunicorn через proxy_pass.
    gzip on;
    gzip_proxied any;
    gzip_min_length 1000;
    gzip_types application/json;
    gzip_vary on;

    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    # Резюме — персональные данные, отдаём только через Django (проверка прав
    # staff + X-Accel-Redirect). Прямые ссылки на /media/vacancies/resumes/ → 404.
    location /media/vacancies/resumes/ {
        internal;
        alias /app/media/vacancies/resumes/;
    }

    location /media/ {
        alias /app/media/;
        add_header X-Content-Type-Options nosniff always;
    }

    # Видео сторисов грузятся через админку — до MAX_STORY_VIDEO_SIZE (100 МБ).
    location /admin/ {
        client_max_body_size 110M;
        include /etc/nginx/conf.d/proxy_to_web.inc;
    }

    location = /admin/login/ {
        limit_req zone=admin_login burst=5 nodelay;
        include /etc/nginx/conf.d/proxy_to_web.inc;
    }

    location /api/v1/ {
        limit_req zone=api_write burst=10 nodelay;
        include /etc/nginx/conf.d/proxy_to_web.inc;
    }

    location / {
        include /etc/nginx/conf.d/proxy_to_web.inc;
    }
}
