# Переменные для ИНТЕРПОЛЯЦИИ compose-файла (${DOMAIN}, ${DOCKER_IMAGE}).
# Compose читает этот файл автоматически, так как он лежит рядом с
# docker-compose.yml — поэтому ручные `docker compose ...` работают без export.
#
# Секреты приложения живут в .env.prod (он подключается как env_file и внутрь
# интерполяции не попадает). Здесь дублируются только эти две переменные.
#
# На сервере: cp docker/prod/.env.example docker/prod/.env && отредактировать.
DOMAIN=yourdomain.com
DOCKER_IMAGE=ghcr.io/pxrpgill/alexa-backend:latest
